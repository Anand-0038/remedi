# live = real DataHub GMS. fixture is only for isolated offline verification.
REMEDI_MODE=live
# Required in live mode; send as Authorization: Bearer <key> or X-API-Key.
REMEDI_API_KEY=replace-with-a-local-secret
DATAHUB_GMS_URL=http://localhost:8080
# Leave empty for an unauthenticated local quickstart. Set for protected deployments.
DATAHUB_TOKEN=
# Optional LLM codegen. If configured, provider failures fail closed.
# OPENAI_API_KEY=
# Optional approved-action delivery. Without this, Apply records examples/notifications/outbox.json.
# Setting a webhook also requires REMEDI_API_KEY.
# REMEDI_OPS_WEBHOOK_URL=https://hooks.slack.com/services/...
# REMEDI_OPS_WEBHOOK_KIND=slack
HOST=0.0.0.0
PORT=8790
