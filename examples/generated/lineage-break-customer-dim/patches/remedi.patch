+{{
+  config(materialized='view', tags=['remedi', 'lineage-repair'])
+}}
+
+-- Generated by Remedi for incident: lineage-break-customer-dim
+-- Grounded in DataHub URN: urn:li:dataset:(urn:li:dataPlatform:dbt,retail.dim_customer,PROD)
+-- Schema columns: customer_sk, email, country
+-- Observed query (DataHub):
+-- SELECT o.order_id, c.customer_id FROM retail.orders o LEFT JOIN retail.dim_customer c ON o.customer_id = c.customer_id
+
+-- Repair broken lineage edge:
+--   upstream:   urn:li:dataset:(urn:li:dataPlatform:snowflake,retail.customers,PROD)
+--   downstream: retail.fct_orders_enriched
+-- Restore missing column `customer_id` from `retail.customers`.
+-- Join key `email` exists in both DataHub schemas.
+
+SELECT
+  d.*,
+  u.customer_id AS customer_id
+FROM {{ ref('dim_customer') }} d
+LEFT JOIN retail.customers u
+  ON d.email = u.email
+WHERE u.customer_id IS NOT NULL
