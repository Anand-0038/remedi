+{{
+  config(
+    materialized='incremental',
+    unique_key='order_date',
+    on_schema_change='append_new_columns',
+    tags=['remedi', 'freshness-guard']
+  )
+}}
+
+-- Generated by Remedi for incident: freshness-ecommerce-orders
+-- Grounded in DataHub URN: urn:li:dataset:(urn:li:dataPlatform:snowflake,ecommerce.raw_orders,PROD)
+-- Schema columns: order_id, order_date, gmv, updated_at
+-- Observed query (DataHub):
+-- SELECT order_date, SUM(gmv) FROM ecommerce.raw_orders GROUP BY 1 ORDER BY 1 DESC LIMIT 7
+
+WITH source AS (
+  SELECT
+    order_date,
+    COUNT(*) AS row_count,
+    SUM(gmv) AS metric_sum,
+    MAX(updated_at) AS last_event
+  FROM {{ source('ecommerce', 'raw_orders') }}
+  WHERE order_date >= DATEADD('day', -7, CURRENT_DATE)
+  {% if is_incremental() %}
+    AND order_date > (SELECT COALESCE(MAX(order_date), '1900-01-01') FROM {{ this }})
+  {% endif %}
+  GROUP BY 1
+),
+freshness_check AS (
+  SELECT
+    *,
+    DATEDIFF('hour', last_event, CURRENT_TIMESTAMP()) AS lag_hours
+  FROM source
+)
+SELECT
+  order_date AS event_date,
+  row_count,
+  metric_sum,
+  last_event,
+  lag_hours,
+  IFF(lag_hours > 4, 'STALE', 'OK') AS freshness_status
+FROM freshness_check
