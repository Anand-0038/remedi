@@ -0,0 +1,42 @@
+{{
+  config(
+    materialized='incremental',
+    unique_key='pickup_date',
+    on_schema_change='append_new_columns',
+    tags=['remedi', 'freshness-guard']
+  )
+}}
+
+-- Generated by Remedi for incident: freshness-nyc-taxi
+-- Grounded in DataHub URN: urn:li:dataset:(urn:li:dataPlatform:snowflake,analytics.nyc_taxi.yellow_trips,PROD)
+-- Schema columns: pickup_datetime, dropoff_datetime, passenger_count, trip_distance, fare_amount, pickup_date
+-- Observed query (DataHub):
+-- SELECT COUNT(*) FROM analytics.nyc_taxi.yellow_trips WHERE pickup_date = CURRENT_DATE - 1
+
+WITH source AS (
+  SELECT
+    pickup_date,
+    COUNT(*) AS row_count,
+    SUM(trip_distance) AS metric_sum,
+    MAX(pickup_datetime) AS last_event
+  FROM {{ source('nyc_taxi', 'yellow_trips') }}
+  WHERE pickup_date >= DATEADD('day', -7, CURRENT_DATE)
+  {% if is_incremental() %}
+    AND pickup_date > (SELECT COALESCE(MAX(pickup_date), '1900-01-01') FROM {{ this }})
+  {% endif %}
+  GROUP BY 1
+),
+freshness_check AS (
+  SELECT
+    *,
+    DATEDIFF('hour', last_event, CURRENT_TIMESTAMP()) AS lag_hours
+  FROM source
+)
+SELECT
+  pickup_date AS event_date,
+  row_count,
+  metric_sum,
+  last_event,
+  lag_hours,
+  IFF(lag_hours > 6, 'STALE', 'OK') AS freshness_status
+FROM freshness_check
