+"""Airflow patch generated by Remedi — incident freshness-nyc-taxi.
+
+Owners discovered through DataHub lineage are retained in remediation evidence.
+"""
+
+from datetime import datetime, timedelta
+
+from airflow import DAG
+from airflow.operators.bash import BashOperator
+from airflow.operators.empty import EmptyOperator
+
+default_args = {
+    "owner": "data-oncall",
+    "retries": 2,
+    "retry_delay": timedelta(minutes=10),
+}
+
+with DAG(
+    dag_id="airflow_nyc_taxi_daily_remedi_guard",
+    start_date=datetime(2026, 1, 1),
+    schedule="0 */3 * * *",
+    catchup=False,
+    tags=["remedi", "freshness"],
+    default_args=default_args,
+) as dag:
+    start = EmptyOperator(task_id="start")
+
+    check_source = BashOperator(
+        task_id="check_source_freshness",
+        bash_command=("dbt source freshness --select source:nyc_taxi.yellow_trips"),
+    )
+
+    run_dbt = BashOperator(
+        task_id="dbt_run_freshness_mart",
+        bash_command=(
+            "dbt run --select mart_yellow_trips_daily --vars '{incident_id: freshness-nyc-taxi}'"
+        ),
+    )
+
+    assert_fresh = BashOperator(
+        task_id="assert_freshness_sla",
+        bash_command=(
+            "dbt test --select mart_yellow_trips_daily,test_type:freshness "
+            "|| (echo 'Remedi: freshness still breached for "
+            "analytics.nyc_taxi.yellow_trips' && exit 1)"
+        ),
+    )
+
+    start >> check_source >> run_dbt >> assert_fresh
