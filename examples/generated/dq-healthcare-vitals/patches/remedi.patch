+-- Grounded in DataHub URN: urn:li:dataset:(urn:li:dataPlatform:postgres,healthcare.vitals,PROD)
+-- Schema columns: patient_id, heart_rate, measured_at
+-- Observed query (DataHub):
+-- SELECT COUNT(*) FILTER (WHERE heart_rate IS NULL)::float / COUNT(*) FROM healthcare.vitals WHERE measured_at > NOW() - INTERVAL '1 day'
+
+-- Remedi DQ quarantine + clean view for healthcare.vitals
+-- Assertion: heart_rate_not_null (null_rate=0.18)
+
+CREATE OR REPLACE VIEW healthcare.vitals_quarantine AS
+SELECT *
+FROM healthcare.vitals
+WHERE heart_rate IS NULL
+  AND measured_at > NOW() - INTERVAL '1 day';
+
+CREATE OR REPLACE VIEW healthcare.vitals_clean AS
+SELECT *
+FROM healthcare.vitals
+WHERE heart_rate IS NOT NULL;
