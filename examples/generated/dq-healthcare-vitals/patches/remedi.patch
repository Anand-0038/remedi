+"""ML feature quality gate — generated by Remedi (dq-healthcare-vitals).
+
+Blocks inference/training when feature `heart_rate` null-rate exceeds threshold.
+Protects models: sepsis_risk_v1
+Features: heart_rate_feature
+"""
+
+from __future__ import annotations
+
+PROTECTED_MODELS = ["sepsis_risk_v1"]
+FEATURE_NAMES = ["heart_rate_feature"]
+FEATURE_COL = "heart_rate"
+SOURCE_URN = "urn:li:dataset:(urn:li:dataPlatform:postgres,healthcare.vitals,PROD)"
+NULL_RATE_THRESHOLD = float(0.02)
+
+
+def null_rate(values: list) -> float:
+    if not values:
+        return 0.0
+    return sum(1 for v in values if v is None) / len(values)
+
+
+def assert_feature_quality(batch_values: list) -> None:
+    rate = null_rate(batch_values)
+    if rate > NULL_RATE_THRESHOLD:
+        raise RuntimeError(
+            f"Remedi DQ ML gate: {FEATURE_COL} null_rate={rate:.3f} > {NULL_RATE_THRESHOLD} "
+            f"for models {PROTECTED_MODELS} / features {FEATURE_NAMES}"
+        )
+
+
+def should_skip_scoring(batch_values: list) -> bool:
+    return null_rate(batch_values) > NULL_RATE_THRESHOLD
