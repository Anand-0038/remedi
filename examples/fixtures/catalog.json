{
  "incidents": [
    {
      "id": "freshness-nyc-taxi",
      "title": "NYC Taxi yellow trips freshness SLA breached",
      "type": "freshness",
      "severity": "high",
      "entity_urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,analytics.nyc_taxi.yellow_trips,PROD)",
      "details": {
        "sla_hours": 6,
        "last_success_hours_ago": 29,
        "pipeline": "airflow.nyc_taxi_daily",
        "expected_schedule": "0 */6 * * *",
        "failure_hint": "stage_2 extract job skipped after upstream S3 partition missing; sensor timeout not alerting owners"
      },
      "sample_queries": [
        "SELECT COUNT(*) FROM analytics.nyc_taxi.yellow_trips WHERE pickup_date = CURRENT_DATE - 1",
        "SELECT MAX(pickup_datetime) AS last_trip FROM analytics.nyc_taxi.yellow_trips"
      ]
    },
    {
      "id": "dq-healthcare-vitals",
      "title": "Healthcare vitals null-rate spike on heart_rate",
      "type": "data_quality",
      "severity": "critical",
      "entity_urn": "urn:li:dataset:(urn:li:dataPlatform:postgres,healthcare.vitals,PROD)",
      "details": {
        "assertion": "heart_rate_not_null",
        "null_rate": 0.18,
        "threshold": 0.02,
        "rows_affected": 9900
      },
      "sample_queries": [
        "SELECT COUNT(*) FILTER (WHERE heart_rate IS NULL)::float / COUNT(*) FROM healthcare.vitals WHERE measured_at > NOW() - INTERVAL '1 day'"
      ]
    },
    {
      "id": "schema-orders-amount",
      "title": "Retail orders.amount type widened without downstream notice",
      "type": "schema_drift",
      "severity": "medium",
      "entity_urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,retail.orders,PROD)",
      "details": {
        "column": "amount",
        "before": "NUMBER(10,2)",
        "after": "NUMBER(18,4)",
        "breaking_for": [
          "looker.finance_gmv",
          "dbt.mart_daily_revenue"
        ]
      },
      "sample_queries": [
        "SELECT amount::NUMBER(10,2) FROM retail.orders LIMIT 10"
      ]
    },
    {
      "id": "lineage-break-customer-dim",
      "title": "Broken lineage: orders \u2192 dim_customer join key missing",
      "type": "lineage_break",
      "severity": "high",
      "entity_urn": "urn:li:dataset:(urn:li:dataPlatform:dbt,retail.dim_customer,PROD)",
      "details": {
        "broken_edge": {
          "upstream": "urn:li:dataset:(urn:li:dataPlatform:snowflake,retail.customers,PROD)",
          "downstream": "retail.fct_orders_enriched",
          "missing_column": "customer_id"
        },
        "failure_hint": "dim_customer lost customer_id in last dbt refactor; fct_orders_enriched join returns nulls and lineage edge dropped"
      },
      "sample_queries": [
        "SELECT o.order_id, c.customer_id FROM retail.orders o LEFT JOIN retail.dim_customer c ON o.customer_id = c.customer_id"
      ]
    },
    {
      "id": "freshness-ecommerce-orders",
      "title": "Ecommerce Snowflake\u2192dbt\u2192Looker freshness break (showcase)",
      "type": "freshness",
      "severity": "high",
      "entity_urn": "urn:li:dataset:(urn:li:dataPlatform:snowflake,ecommerce.raw_orders,PROD)",
      "details": {
        "sla_hours": 4,
        "last_success_hours_ago": 18,
        "pipeline": "airflow.ecommerce_orders_hourly",
        "failure_hint": "Kafka\u2192Snowflake land delayed; Looker GMV tile stale across platforms"
      },
      "sample_queries": [
        "SELECT order_date, SUM(gmv) FROM ecommerce.raw_orders GROUP BY 1 ORDER BY 1 DESC LIMIT 7"
      ]
    }
  ],
