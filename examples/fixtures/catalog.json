  "queries": {
    "urn:li:dataset:(urn:li:dataPlatform:snowflake,analytics.nyc_taxi.yellow_trips,PROD)": [
      "SELECT pickup_date, COUNT(*) AS trips, SUM(fare_amount) AS gmv\nFROM analytics.nyc_taxi.yellow_trips\nWHERE pickup_date >= DATEADD('day', -7, CURRENT_DATE)\nGROUP BY 1\nORDER BY 1",
      "SELECT MAX(pickup_datetime) AS watermark FROM analytics.nyc_taxi.yellow_trips"
    ],
    "urn:li:dataset:(urn:li:dataPlatform:postgres,healthcare.vitals,PROD)": [
      "SELECT patient_id, heart_rate, measured_at FROM healthcare.vitals WHERE measured_at > NOW() - INTERVAL '1 day'"
    ],
    "urn:li:dataset:(urn:li:dataPlatform:snowflake,retail.orders,PROD)": [
      "SELECT DATE_TRUNC('day', ordered_at) AS d, SUM(amount) FROM retail.orders GROUP BY 1"
    ],
    "urn:li:dataset:(urn:li:dataPlatform:dbt,retail.dim_customer,PROD)": [
      "SELECT customer_sk, email, country FROM retail.dim_customer"
    ],
    "urn:li:dataset:(urn:li:dataPlatform:snowflake,ecommerce.raw_orders,PROD)": [
      "SELECT order_date, COUNT(*) AS orders, SUM(gmv) AS gmv\nFROM ecommerce.raw_orders\nWHERE order_date >= DATEADD('day', -7, CURRENT_DATE)\nGROUP BY 1"
    ]
  },
